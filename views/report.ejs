<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusFix - Report Issue</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">
 
        <div class="sidebar">

            <div class="logo-row">

                <div class="logo-icon">CF</div>

                <div class="logo-text">
                    <h2>CampusFix</h2>
                    <p>Report • Resolve • Improve</p>
                </div>

            </div>

            <a href="/dashboard" class="nav-link">
                🏠 Dashboard
            </a>

            <a href="/report" class="nav-link">
                📝 Report Issue
            </a>

            <a href="/my-reports" class="nav-link">
                📋 My Reports
            </a>

            <a href="/profile" class="nav-link">
                👤 Profile
            </a>

            <div class="sidebar-bottom">
                <p>Better Campus</p>
                <p>For a Brighter Future</p>
            </div>

        </div>
 
        <div class="main">

            <div class="content">

                <div class="page-heading">

                    <h2>Report a Campus Problem</h2>

                    <p>
                        Fill in the details below so the campus team
                        can help you.
                    </p>

                </div>

 
                <div class="card form-card">

                    <form action="/submit-report" method="POST">

                        <label for="category">Issue Category</label>
                        <select id="category" name="category" required>
                            <option value="">Select a category</option>
                            <option>Electrical</option>
                            <option>Wi-Fi</option>
                            <option>Water</option>
                            <option>Cleanliness</option>
                            <option>Furniture</option>
                            <option>Other</option>
                        </select>

                        <label for="building">Building Name</label>
                        <input type="text" id="building" name="building" placeholder="Enter your building name"
                            required>

                        <label for="room">Floor / Room</label>
                        <input type="text" id="room" name="room" placeholder="Example: 2nd Floor, Room 204" required>

                        <label for="title">Problem Title</label>
                        <input type="text" id="title" name="title" placeholder="Example: Fan not working" required>

                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="5"
                            placeholder="Describe the problem in detail..." required></textarea>

                        <button type="submit" class="submit-button">
                            Submit Report
                        </button>

                    </form>

                </div>

              
                <div class="help-card">

                    <h3>What happens after you report?</h3>

                    <p>
                        <strong>1. Report received:</strong>
                        Your report is recorded.
                    </p>

                    <p>
                        <strong>2. Team assigned:</strong>
                        The campus team checks the problem.
                    </p>

                    <p>
                        <strong>3. Problem fixed:</strong>
                        The report status is updated to Resolved.
                    </p>

                </div>

            </div>

            <footer>
                © 2026 CampusFix | Better Campus, Better Future
            </footer>

        </div>

    </div>

</body>

</html>